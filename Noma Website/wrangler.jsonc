{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noma-website",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "nomashift.com", "custom_domain": true },
    { "pattern": "www.nomashift.com", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  }
}

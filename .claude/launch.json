{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "noma-website",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "Noma Website/node_modules/vite/bin/vite.js",
        "Noma Website",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "noma-website-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5181",
        "--directory",
        "Noma Website/dist"
      ],
      "port": 5181
    }
  ]
}